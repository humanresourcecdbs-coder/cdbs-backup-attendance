<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CDBS Backup Attendance Scanner</title>
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; background: #f4f4f9; padding: 20px; }
    .card { background: white; max-width: 400px; margin: 0 auto; padding: 20px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    #reader { width: 100%; margin-top: 15px; }
    #status { margin-top: 15px; font-weight: bold; padding: 10px; border-radius: 6px; display: none; }
    .success { background: #d4edda; color: #155724; }
    .error { background: #f8d7da; color: #721c24; }
  </style>
</head>
<body>
  <div class="card">
    <h2>CDBS Attendance Scanner</h2>
    <p>Scan your Employee ID QR Code</p>
    <div id="reader"></div>
    <div id="status"></div>
  </div>

  <script>
    // PASTE YOUR GOOGLE APPS SCRIPT WEB APP URL BELOW BETWEEN THE QUOTES
    const SCRIPT_URL = "YOUR_APPS_SCRIPT_WEB_APP_URL_HERE";

    let isProcessing = false;

    function onScanSuccess(decodedText) {
      if (isProcessing) return;
      isProcessing = true;

      const statusDiv = document.getElementById("status");
      statusDiv.style.display = "block";
      statusDiv.className = "";
      statusDiv.innerText = "Processing ID: " + decodedText + "...";

      fetch(SCRIPT_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({ "employeeId": decodedText })
      })
      .then(() => {
        statusDiv.className = "success";
        statusDiv.innerText = "Successfully recorded! ID: " + decodedText;
        setTimeout(() => {
          statusDiv.style.display = "none";
          isProcessing = false;
        }, 3000);
      })
      .catch(err => {
        statusDiv.className = "error";
        statusDiv.innerText = "Error logging attendance. Try again.";
        console.error(err);
        setTimeout(() => { isProcessing = false; }, 3000);
      });
    }

    const html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: 250 });
    html5QrcodeScanner.render(onScanSuccess);
  </script>
</body>
</html>
